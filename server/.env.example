# Copy to /etc/veyro/mailer.env on the server and fill in. Never commit real values.
PORT=8787
MAIL_TO=sales@veyrotrack.com
MAIL_FROM="Veyro Website <no-reply@veyrotrack.com>"
ALLOWED_ORIGINS=https://veyrotrack.com,https://www.veyrotrack.com

# SMTP — Amazon SES example (create SMTP credentials in the SES console,
# verify the veyrotrack.com domain, and request production access).
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

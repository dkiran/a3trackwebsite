# Copy to /etc/a3track/mailer.env on the server and fill in. Never commit real values.
PORT=8787
MAIL_TO=sales@a3track.com
MAIL_FROM="A3Track Website <no-reply@a3track.com>"
ALLOWED_ORIGINS=https://a3track.com,https://www.a3track.com

# SMTP — Amazon SES example (create SMTP credentials in the SES console,
# verify the a3track.com domain, and request production access).
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Copy to /etc/veyro/mailer.env on the server and fill in. Never commit real values.
PORT=8787
MAIL_TO=sales@veyro.com
MAIL_FROM="Veyro Website <no-reply@veyro.com>"
ALLOWED_ORIGINS=https://veyro.com,https://www.veyro.com

# SMTP — Amazon SES example (create SMTP credentials in the SES console,
# verify the veyro.com domain, and request production access).
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

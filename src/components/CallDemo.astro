---
// Animated phone call with the AI agent, followed by an automated alert call that escalates.
const { plate = 'AP09CC2318' } = Astro.props;
const langs = ['English', 'हिन्दी', 'తెలుగు', 'தமிழ்', 'ಕನ್ನಡ', 'मराठी', 'বাংলা', 'മലയാളം'];
---
<div class="phone call" data-demo="13000" role="img" aria-label={`Illustration of a phone call with the A3Track AI agent. The caller asks for the status of ${plate} and the agent answers. Then an automated alert call for overspeeding goes unanswered by the driver and is escalated to the fleet manager.`}>
  <div class="phone__screen">
    <div class="call__top">
      <span class="call__av"><i></i><i></i>AI</span>
      <strong>A3Track AI Agent</strong>
      <small>Voice call · 24/7</small>
      <div class="call__wave">{Array.from({ length: 18 }).map((_, i) => <i style={`--i:${i}`}></i>)}</div>
    </div>
    <div class="call__body">
      <div class="t t--you step" style="--t:.6s"><small>You</small>What is the status of {plate}?</div>
      <div class="t t--ai step" style="--t:2.2s"><small>AI agent</small>{plate} is moving at 46 km/h near Gachibowli. It will reach the depot in about 25 minutes.</div>
      <div class="alert step" style="--t:4.8s">
        <div class="alert__h"><span></span><strong>Automated alert call</strong></div>
        <p>Overspeed: 92 km/h on ORR · {plate}</p>
        <ol>
          <li class="step" style="--t:5.8s"><i class="x"></i>Driver called · no answer</li>
          <li class="step" style="--t:7s"><i class="ok"></i>Escalated to fleet manager</li>
          <li class="step" style="--t:8.2s"><i class="ok"></i>Acknowledged · logged</li>
        </ol>
      </div>
    </div>
    <div class="call__langs">{langs.map((l) => <span>{l}</span>)}</div>
  </div>
</div>

<style>
  .phone { width: min(100%, 300px); margin-inline: auto; border-radius: 38px; padding: 9px; background: #0f172a; box-shadow: 0 40px 80px -40px rgba(15, 23, 42, 0.7), 0 0 0 1px rgba(15, 23, 42, 0.9); }
  .phone__screen { border-radius: 30px; overflow: hidden; background: linear-gradient(180deg, #172554, #0f1a3d); color: #f1f5ff; display: flex; flex-direction: column; font-size: 0.84rem; line-height: 1.38; letter-spacing: 0; }
  .call__top { display: grid; justify-items: center; gap: 2px; padding: 20px 14px 10px; text-align: center; }
  .call__av { position: relative; width: 52px; height: 52px; border-radius: 50%; background: #2563eb; display: grid; place-items: center; font: 700 0.9rem/1 var(--font); margin-bottom: 8px; }
  .call__av i { position: absolute; inset: 0; border-radius: 50%; border: 2px solid #60a5fa; animation: call-ring 2.2s ease-out infinite; }
  .call__av i:nth-child(2) { animation-delay: 1.1s; }
  .call__top strong { font-size: 0.98rem; font-weight: 600; }
  .call__top small { color: #b3c2e0; font-size: 0.72rem; }
  .call__wave { display: flex; align-items: center; gap: 3px; height: 22px; margin-top: 8px; }
  .call__wave i { width: 3px; height: 100%; border-radius: 2px; background: #93c5fd; transform: scaleY(.2); animation: call-wave 1.1s ease-in-out infinite; animation-delay: calc(var(--i) * -0.14s); }
  .call__body { display: flex; flex-direction: column; gap: 8px; padding: 8px 12px 10px; min-height: 290px; }
  .t { max-width: 90%; padding: 8px 11px; border-radius: 12px; }
  .t small { display: block; font-size: 0.6rem; letter-spacing: .08em; text-transform: uppercase; opacity: .7; margin-bottom: 1px; }
  .t--you { align-self: flex-end; background: #2563eb; border-bottom-right-radius: 3px; }
  .t--ai { align-self: flex-start; background: rgba(255, 255, 255, 0.09); border: 1px solid rgba(255, 255, 255, 0.12); border-bottom-left-radius: 3px; }
  .alert { margin-top: 2px; border-radius: 12px; padding: 10px 11px; background: rgba(240, 196, 99, 0.1); border: 1px solid rgba(240, 196, 99, 0.45); }
  .alert__h { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; }
  .alert__h span { width: 8px; height: 8px; border-radius: 50%; background: #f0c463; box-shadow: 0 0 0 4px rgba(240, 196, 99, 0.25); }
  .alert p { margin: 4px 0 6px; font-size: 0.78rem; color: #dbe5f7; }
  .alert ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: 0.76rem; }
  .alert li { display: flex; align-items: center; gap: 8px; }
  .alert li i { flex: none; width: 14px; height: 14px; border-radius: 50%; display: grid; place-items: center; font: 700 9px/1 var(--font); font-style: normal; color: #0f1a3d; }
  .alert li i.x { background: #ff7a85; } .alert li i.x::before { content: '×'; }
  .alert li i.ok { background: #5fd3a0; } .alert li i.ok::before { content: '✓'; }
  .call__langs { display: flex; flex-wrap: wrap; justify-content: center; gap: 5px; padding: 10px 10px 16px; border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .call__langs span { font-size: 0.7rem; padding: 4px 9px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.2); color: #dbe5f7; font-family: system-ui, 'Noto Sans', 'Nirmala UI', sans-serif; }

  :global(.js) .call:not(.play) .step { opacity: 0; }
  .call.play .step { animation: call-in .45s cubic-bezier(.2, .8, .2, 1) both; animation-delay: var(--t); }
  @keyframes call-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes call-ring { from { transform: scale(1); opacity: .8; } to { transform: scale(1.7); opacity: 0; } }
  @keyframes call-wave { 0%, 100% { transform: scaleY(.2); } 50% { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) { :global(.js) .call .step { opacity: 1 !important; animation: none !important; } }
</style>

<script>
  import { initStandaloneDemos } from '../scripts/demo';
  initStandaloneDemos();
</script>

---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
const { title, description, path } = Astro.props;
const crumbs = [{ name: title, href: path }];
---
<Base title={title} description={description} crumbs={crumbs}>
  <PageHero crumbs={crumbs} eyebrow="Legal" title={title} cta={false} />
  <section class="section section--alt" style="padding-top:40px"><div class="container prose">
    <blockquote><p><strong>Template notice:</strong> this page is a general template and is not legal advice. Have it reviewed by qualified counsel and updated with your company details before launch.</p></blockquote>
    <slot />
  </div></section>
</Base>

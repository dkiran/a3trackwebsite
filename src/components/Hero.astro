---
import LiveMapDemo from './LiveMapDemo.astro';
import WhatsAppDemo from './WhatsAppDemo.astro';
import CallDemo from './CallDemo.astro';
const slides = [
  { tab: 'Live map', title: 'One live view of your whole fleet', text: 'Track every vehicle, driver and asset in real time. AI flags risk, fuel waste and breakdowns as they happen.', href: '/platform/', cta: 'Explore the platform', ms: 8000 },
  { tab: 'WhatsApp', title: 'Your fleet, on WhatsApp', text: 'Type or send a voice message, in English or your own language: “Where is my vehicle AP09CC2318?” The AI agent answers in the same language, by text or voice, with the live map in the chat.', href: '/platform/ai-agent/', cta: 'See the AI agent', ms: 20000 },
  { tab: 'AI calls', title: 'Call the AI agent, 24/7', text: 'Dial our AI call centre for the status of any vehicle. When an alert crosses your threshold, the agent calls you and escalates until someone answers. In English and regional languages.', href: '/platform/ai-agent/', cta: 'How AI calls work', ms: 12000 },
];
---
<section class="hero" data-carousel>
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__in">
    <div class="hero__copy">
      <span class="hero__badge"><i></i> AI-powered GPS telematics platform</span>
      <h1>Move <span class="grad-text">Smarter.</span></h1>
      <div class="caps" aria-live="polite">
        {slides.map((sl, i) => (
          <div class={`cap ${i === 0 ? 'is-active' : ''}`} data-cap={i}>
            <h2>{sl.title}</h2>
            <p>{sl.text} <a class="arrow-link" href={sl.href}>{sl.cta}</a></p>
          </div>
        ))}
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact/#demo">Request a demo</a>
        <a class="btn btn--ghost" href="/platform/ai-agent/">Meet the AI agent</a>
      </div>
      <div class="tabs" role="tablist" aria-label="Product highlights">
        {slides.map((sl, i) => (
          <button class={`tab ${i === 0 ? 'is-active' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i} data-ms={sl.ms}><span>{sl.tab}</span><i></i></button>
        ))}
      </div>
    </div>

    <div class="hero__viz">
      <div class="stage">
        <div class="slide is-active" data-slide="0" role="img" aria-label="Animated illustration of the A3Track live fleet map with vehicles moving along routes and AI alerts appearing">
          <LiveMapDemo />
          <p class="viz__note">Illustrative product view</p>
        </div>
        <div class="slide" data-slide="1"><WhatsAppDemo /><p class="viz__note" style="text-align:center">Illustrative conversation</p></div>
        <div class="slide" data-slide="2"><CallDemo /><p class="viz__note" style="text-align:center">Illustrative call</p></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding: clamp(40px, 6vw, 84px) 0 clamp(56px, 8vw, 110px); overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; background:
    radial-gradient(900px 520px at 80% 8%, rgba(37, 99, 235, 0.13), transparent 62%),
    radial-gradient(700px 420px at 0% 100%, rgba(37, 99, 235, 0.12), transparent 62%); }
  .hero__bg::after { content: ''; position: absolute; inset: 0; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse at 50% 0%, #000, transparent 72%); -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000, transparent 72%); opacity: .45; }
  .hero__in { position: relative; display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); gap: clamp(28px, 4vw, 56px); align-items: center; }
  .hero__badge { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line-strong); background: var(--bg-2); font-size: 0.84rem; font-weight: 500; color: var(--text); margin-bottom: 22px; }
  .hero__badge i { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 0 rgba(31, 157, 110, 0.6); animation: beat 2s infinite; }
  .hero h1 { font-size: clamp(3.2rem, 8vw, 6rem); line-height: 1.02; letter-spacing: -0.035em; margin-bottom: 0.3em; font-weight: 600; }
  
  .hero__copy > * { animation: rise .9s cubic-bezier(.2, .7, .2, 1) both; }
  .hero__copy > :nth-child(2) { animation-delay: .08s; } .hero__copy > :nth-child(3) { animation-delay: .16s; }
  .hero__copy > :nth-child(4) { animation-delay: .24s; } .hero__copy > :nth-child(5) { animation-delay: .32s; }

  .caps { display: grid; margin-bottom: 26px; }
  .cap { grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity .5s, transform .5s, visibility .5s; }
  .cap.is-active { opacity: 1; visibility: visible; transform: none; }
  .cap h2 { font-size: clamp(1.3rem, 2.2vw, 1.75rem); margin-bottom: 8px; }
  .cap p { color: var(--muted); font-size: clamp(1.02rem, 1.4vw, 1.15rem); line-height: 1.45; max-width: 52ch; margin: 0; }
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 30px; }
  .tab { position: relative; overflow: hidden; border: 1px solid var(--line-strong); background: #fff; color: var(--muted); font: 500 0.9rem/1 var(--font); padding: 10px 16px; border-radius: 999px; cursor: pointer; transition: color .2s, border-color .2s; }
  .tab:hover { color: var(--text); }
  .tab.is-active { color: #1d4ed8; border-color: #2563eb; }
  .tab span { position: relative; z-index: 1; }
  .tab i { position: absolute; inset: 0; background: #dbeafe; transform: scaleX(0); transform-origin: left; }
  .tab.is-active i { animation: tabfill var(--ms, 8s) linear forwards; }
  .hero.is-paused .tab.is-active i { animation-play-state: paused; }
  .stage { display: grid; align-items: center; }
  .slide { grid-area: 1 / 1; min-width: 0; opacity: 0; visibility: hidden; transform: scale(.97) translateY(10px); transition: opacity .6s, transform .6s, visibility .6s; }
  .slide.is-active { opacity: 1; visibility: visible; transform: none; }
  @keyframes tabfill { to { transform: scaleX(1); } }

  .hero__viz { animation: rise 1.1s .2s cubic-bezier(.2, .7, .2, 1) both; min-width: 0; }
  .viz__note { text-align: right; font-size: 0.72rem; color: #6b7c98; margin: 10px 4px 0; }

  @keyframes rise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
  @keyframes beat { 0% { box-shadow: 0 0 0 0 rgba(31, 157, 110, 0.6); } 70%, 100% { box-shadow: 0 0 0 10px rgba(31, 157, 110, 0); } }

  @media (max-width: 940px) {
    .stage { align-items: start; }
    .hero__in { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tab.is-active i { animation: none; transform: scaleX(1); }
  }
</style>

<script>
  import { playDemo } from '../scripts/demo';

  const hero = document.querySelector<HTMLElement>('[data-carousel]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const caps = [...hero.querySelectorAll<HTMLElement>('[data-cap]')];
    const tabs = [...hero.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const svg = hero.querySelector<SVGSVGElement>('.viz__svg');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let timer: number | undefined;
    let visible = true;
    let hovering = false;

    const schedule = () => {
      clearTimeout(timer);
      const paused = reduce.matches || !visible || hovering;
      hero.classList.toggle('is-paused', paused);
      if (!paused) timer = window.setTimeout(() => show((current + 1) % slides.length), Number(tabs[current].dataset.ms));
      // The map uses SVG (SMIL) animation: pause it when it is not the slide on screen.
      if (svg) (reduce.matches || !visible || current !== 0 ? svg.pauseAnimations() : svg.unpauseAnimations());
    };

    const show = (i: number) => {
      current = i;
      slides.forEach((el, k) => el.classList.toggle('is-active', k === i));
      caps.forEach((el, k) => el.classList.toggle('is-active', k === i));
      tabs.forEach((el, k) => {
        el.classList.remove('is-active');
        el.setAttribute('aria-selected', String(k === i));
      });
      void tabs[i].offsetWidth; // restart the progress fill
      tabs[i].classList.add('is-active');
      tabs[i].style.setProperty('--ms', `${tabs[i].dataset.ms}ms`);
      const demo = slides[i].querySelector('[data-demo]');
      if (demo) playDemo(demo);
      schedule();
    };

    tabs.forEach((t, i) => t.addEventListener('click', () => show(i)));
    hero.querySelector('.hero__in')!.addEventListener('mouseenter', () => { hovering = true; schedule(); });
    hero.querySelector('.hero__in')!.addEventListener('mouseleave', () => { hovering = false; schedule(); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; schedule(); }, { threshold: 0.2 }).observe(hero);
    reduce.addEventListener('change', schedule);
    tabs[0].style.setProperty('--ms', `${tabs[0].dataset.ms}ms`);
    schedule();
  }
</script>

---
const routes = [
  { id: 'r1', d: 'M-10 372 C 90 360, 120 300, 200 292 S 330 330, 392 262 S 470 150, 560 132 S 640 120, 660 96', dur: 26, color: '#3fd6c6' },
  { id: 'r2', d: 'M80 -10 C 96 80, 150 120, 232 132 S 380 110, 432 182 S 470 320, 540 362 S 620 400, 660 420', dur: 32, color: '#5fb0ee' },
  { id: 'r3', d: 'M-10 150 C 70 160, 130 210, 232 212 S 330 180, 392 262 S 380 400, 300 430 S 200 470, 160 500', dur: 38, color: '#dff3f3' },
];
const vehicles = [
  { r: 'r1', begin: 0, c: '#3fd6c6' }, { r: 'r1', begin: -13, c: '#3fd6c6' },
  { r: 'r2', begin: -5, c: '#5fb0ee' }, { r: 'r2', begin: -20, c: '#5fb0ee' },
  { r: 'r3', begin: -9, c: '#ffffff' }, { r: 'r3', begin: -27, c: '#f0c463' },
];
const alerts = [
  { tone: 'amber', title: 'Harsh braking detected', meta: 'Truck 214 · NH48 · coaching clip saved' },
  { tone: 'teal', title: 'Route re-optimised', meta: '3 stops resequenced · 18 min saved' },
  { tone: 'red', title: 'Fuel drain alert', meta: 'Tipper 031 · 22 L while parked' },
  { tone: 'blue', title: 'Service predicted', meta: 'Bus 77 · battery health declining' },
];
---
<section class="hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__in">
    <div class="hero__copy">
      <span class="hero__badge"><i></i> AI-powered GPS telematics platform</span>
      <h1>Move <span class="grad-text">Smarter.</span></h1>
      <p class="lead">
        A3Track connects every vehicle, driver and asset to one intelligent platform. Track in real time, prevent
        incidents with AI, cut fuel waste and stay compliant, from five vehicles to fifty thousand.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact/#demo">Request a demo</a>
        <a class="btn btn--ghost" href="/platform/">Explore the platform</a>
      </div>
      <ul class="hero__points">
        <li>Real-time GPS tracking</li><li>AI dash cams</li><li>Fuel &amp; maintenance</li><li>Open API</li>
      </ul>
    </div>

    <div class="hero__viz" role="img" aria-label="Animated illustration of the A3Track live fleet map with vehicles moving along routes and AI alerts appearing">
      <div class="viz">
        <div class="viz__bar"><span></span><span></span><span></span><em>app.a3track.com / live-map</em></div>
        <div class="viz__map">
          <svg viewBox="0 0 640 480" preserveAspectRatio="xMidYMid slice" class="viz__svg" aria-hidden="true">
            <defs>
              <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="rgba(200, 240, 240,.09)" stroke-width="1" /></pattern>
              <radialGradient id="glow" cx="50%" cy="45%" r="60%"><stop offset="0" stop-color="#0d5566" stop-opacity=".9" /><stop offset="1" stop-color="#062c38" stop-opacity="0" /></radialGradient>
              <filter id="blur"><feGaussianBlur stdDeviation="4" /></filter>
            </defs>
            <rect width="640" height="480" fill="#062c38" />
            <rect width="640" height="480" fill="url(#glow)" />
            <rect width="640" height="480" fill="url(#grid)" />
            <!-- city blocks & minor roads -->
            <g fill="rgba(63, 214, 198,.05)" stroke="rgba(200, 240, 240,.1)">
              <rect x="60" y="60" width="90" height="56" rx="6" /><rect x="270" y="30" width="110" height="70" rx="6" />
              <rect x="470" y="210" width="120" height="80" rx="6" /><rect x="70" y="400" width="130" height="50" rx="6" />
              <rect x="250" y="330" width="80" height="60" rx="6" /><rect x="480" y="30" width="60" height="60" rx="6" />
            </g>
            <g fill="none" stroke="rgba(200, 240, 240,.16)" stroke-width="6" stroke-linecap="round">
              <path d="M0 250 H640" /><path d="M232 0 V480" /><path d="M432 0 V480" /><path d="M0 80 L640 400" opacity=".5" />
            </g>
            <!-- geofence -->
            <g transform="translate(392 262)">
              <circle r="62" fill="rgba(63, 214, 198,.06)" stroke="#3fd6c6" stroke-width="1.5" stroke-dasharray="6 6" class="spin" />
              <circle r="5" fill="#3fd6c6" /><circle r="5" fill="none" stroke="#3fd6c6" class="ping" />
            </g>
            <g transform="translate(232 132)"><circle r="4" fill="#5fb0ee" /><circle r="4" fill="none" stroke="#5fb0ee" class="ping ping--2" /></g>
            <g transform="translate(232 212)"><circle r="4" fill="#f0c463" /><circle r="4" fill="none" stroke="#f0c463" class="ping ping--3" /></g>
            <!-- routes -->
            {routes.map((r) => (
              <g>
                <path d={r.d} fill="none" stroke={r.color} stroke-width="8" opacity=".18" filter="url(#blur)" />
                <path id={r.id} d={r.d} fill="none" stroke={r.color} stroke-width="2.5" stroke-linecap="round" class="route" pathLength="1000" />
              </g>
            ))}
            <!-- vehicles -->
            {vehicles.map((v) => {
              const r = routes.find((x) => x.id === v.r)!;
              return (
                <g>
                  <circle r="11" fill={v.c} opacity=".18" />
                  <circle r="5.5" fill="#062c38" stroke={v.c} stroke-width="2.5" />
                  <path d="M-2 -2.6 L3 0 L-2 2.6 Z" fill={v.c} />
                  <animateMotion dur={`${r.dur}s`} begin={`${v.begin}s`} repeatCount="indefinite" rotate="auto"><mpath href={`#${r.id}`} /></animateMotion>
                </g>
              );
            })}
          </svg>

          <div class="viz__stat">
            <small>Fleet live</small>
            <strong>248 <span>vehicles</span></strong>
            <div class="bars"><i style="--h:42%"></i><i style="--h:66%"></i><i style="--h:54%"></i><i style="--h:82%"></i><i style="--h:70%"></i><i style="--h:94%"></i><i style="--h:78%"></i></div>
            <div class="legend"><span class="dot dot--t"></span>Moving 181<span class="dot dot--a"></span>Idle 23<span class="dot dot--m"></span>Parked 44</div>
          </div>

          <div class="viz__score">
            <svg viewBox="0 0 44 44" width="44" height="44"><circle cx="22" cy="22" r="18" fill="none" stroke="rgba(200, 240, 240,.2)" stroke-width="4" /><circle cx="22" cy="22" r="18" fill="none" stroke="#5fd3a0" stroke-width="4" stroke-linecap="round" stroke-dasharray="113" stroke-dashoffset="113" transform="rotate(-90 22 22)" class="ring" /></svg>
            <div><small>Safety score</small><strong>92</strong></div>
          </div>

          <div class="viz__alerts">
            {alerts.map((a, i) => (
              <div class={`toast toast--${a.tone}`} style={`--i:${i}`}>
                <span class="toast__dot"></span>
                <div><strong>{a.title}</strong><small>{a.meta}</small></div>
                <em>AI</em>
              </div>
            ))}
          </div>
        </div>
      </div>
      <p class="viz__note">Illustrative product view</p>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding: clamp(40px, 6vw, 84px) 0 clamp(56px, 8vw, 110px); overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; background:
    radial-gradient(900px 520px at 80% 8%, rgba(11, 99, 160, 0.13), transparent 62%),
    radial-gradient(700px 420px at 0% 100%, rgba(15, 159, 149, 0.12), transparent 62%); }
  .hero__bg::after { content: ''; position: absolute; inset: 0; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse at 50% 0%, #000, transparent 72%); -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000, transparent 72%); opacity: .45; }
  .hero__in { position: relative; display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); gap: clamp(28px, 4vw, 56px); align-items: center; }
  .hero__badge { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line-strong); background: var(--bg-2); font-size: 0.84rem; font-weight: 500; color: var(--text); margin-bottom: 22px; }
  .hero__badge i { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 0 rgba(31, 157, 110, 0.6); animation: beat 2s infinite; }
  .hero h1 { font-size: clamp(3.2rem, 8.4vw, 6.4rem); line-height: 0.98; letter-spacing: -0.045em; margin-bottom: 0.32em; font-weight: 700; }
  .hero .lead { margin-bottom: 30px; }
  .hero__points { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 30px; color: var(--muted); font-size: 0.9rem; }
  .hero__points li { position: relative; padding-left: 16px; }
  .hero__points li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 6px; height: 6px; border-radius: 50%; background: var(--teal); }
  .hero__copy > * { animation: rise .9s cubic-bezier(.2, .7, .2, 1) both; }
  .hero__copy > :nth-child(2) { animation-delay: .08s; } .hero__copy > :nth-child(3) { animation-delay: .16s; }
  .hero__copy > :nth-child(4) { animation-delay: .24s; } .hero__copy > :nth-child(5) { animation-delay: .32s; }

  .hero__viz { animation: rise 1.1s .2s cubic-bezier(.2, .7, .2, 1) both; min-width: 0; }
  .viz { border-radius: 20px; border: 1px solid var(--line-strong); background: #062c38; box-shadow: 0 50px 100px -50px rgba(6, 59, 76, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.03) inset; overflow: hidden; transform: perspective(1600px) rotateY(-5deg) rotateX(2deg); transition: transform .6s; }
  .viz:hover { transform: perspective(1600px) rotateY(0) rotateX(0); }
  .viz__bar { display: flex; align-items: center; gap: 6px; padding: 11px 14px; border-bottom: 1px solid var(--line); background: #083542; }
  .viz__bar span { width: 9px; height: 9px; border-radius: 50%; background: #1b5564; }
  .viz__bar em { margin-left: 10px; font: 500 0.72rem/1 var(--font); color: var(--muted); font-style: normal; padding: 5px 10px; border-radius: 6px; background: rgba(255, 255, 255, 0.04); }
  .viz__map { position: relative; aspect-ratio: 4 / 3; }
  .viz__svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .route { stroke-dasharray: 1000; stroke-dashoffset: 1000; animation: draw 3.2s .5s cubic-bezier(.5, 0, .2, 1) forwards; }
  .spin { animation: spin 40s linear infinite; transform-origin: center; transform-box: fill-box; }
  .ping { animation: ping 2.6s ease-out infinite; transform-origin: center; transform-box: fill-box; }
  .ping--2 { animation-delay: .8s; } .ping--3 { animation-delay: 1.6s; }
  .ring { animation: ring 1.8s 1s cubic-bezier(.3, .7, .2, 1) forwards; }

  .viz__stat, .viz__score, .toast { background: rgba(5, 42, 53, 0.86); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid var(--line-strong); border-radius: 14px; }
  .viz__stat { position: absolute; left: 4%; top: 5%; padding: 12px 14px; width: 40%; max-width: 210px; animation: float 7s ease-in-out infinite; }
  .viz__stat small, .viz__score small { display: block; font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .viz__stat strong { font: 700 1.5rem/1.2 var(--display); display: block; }
  .viz__stat strong span { font: 500 0.75rem var(--font); color: var(--muted); }
  .bars { display: flex; align-items: flex-end; gap: 4px; height: 34px; margin: 8px 0; }
  .bars i { flex: 1; height: var(--h); background: var(--grad); border-radius: 3px; transform-origin: bottom; animation: grow 1.2s cubic-bezier(.2, .7, .2, 1) both; }
  .bars i:nth-child(2) { animation-delay: .1s; } .bars i:nth-child(3) { animation-delay: .2s; } .bars i:nth-child(4) { animation-delay: .3s; }
  .bars i:nth-child(5) { animation-delay: .4s; } .bars i:nth-child(6) { animation-delay: .5s; } .bars i:nth-child(7) { animation-delay: .6s; }
  .legend { font-size: 0.62rem; color: var(--muted); display: flex; flex-wrap: wrap; align-items: center; gap: 2px 4px; }
  .dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; margin-left: 4px; }
  .dot:first-child { margin-left: 0; }
  .dot--t { background: var(--ok); } .dot--a { background: var(--amber); } .dot--m { background: #6b8f97; }
  .viz__score { position: absolute; right: 4%; top: 6%; padding: 8px 14px 8px 8px; display: flex; align-items: center; gap: 10px; animation: float 8s 1s ease-in-out infinite; }
  .viz__score strong { font: 700 1.25rem/1 var(--display); }

  .viz__alerts { position: absolute; right: 4%; bottom: 5%; width: min(64%, 300px); height: 58px; }
  .toast { position: absolute; inset: 0; display: flex; align-items: center; gap: 10px; padding: 10px 12px; opacity: 0; animation: toast 16s infinite; animation-delay: calc(var(--i) * 4s + 1.5s); }
  .toast strong { display: block; font-size: 0.8rem; line-height: 1.25; }
  .toast small { display: block; font-size: 0.68rem; color: var(--muted); line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .toast > div { min-width: 0; flex: 1; }
  .toast em { font: 700 0.6rem/1 var(--font); font-style: normal; padding: 4px 6px; border-radius: 5px; background: var(--grad); color: #04242e; }
  .toast__dot { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 25%, transparent); }
  .toast--amber { --c: var(--amber); } .toast--teal { --c: var(--ok); } .toast--red { --c: var(--red); } .toast--blue { --c: var(--sky); }
  .viz__note { text-align: right; font-size: 0.72rem; color: #6b8690; margin: 10px 4px 0; }

  @keyframes rise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes ping { 0% { transform: scale(1); opacity: .9; } 100% { transform: scale(7); opacity: 0; } }
  @keyframes ring { to { stroke-dashoffset: 9; } }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  @keyframes grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes beat { 0% { box-shadow: 0 0 0 0 rgba(31, 157, 110, 0.6); } 70%, 100% { box-shadow: 0 0 0 10px rgba(31, 157, 110, 0); } }
  @keyframes toast { 0% { opacity: 0; transform: translateY(14px) scale(.97); } 3%, 22% { opacity: 1; transform: none; } 25%, 100% { opacity: 0; transform: translateY(-12px) scale(.97); } }

  @media (max-width: 940px) {
    .hero__in { grid-template-columns: 1fr; }
    .viz { transform: none; }
  }
  @media (max-width: 520px) {
    .viz__stat { width: 46%; padding: 9px 10px; } .viz__stat strong { font-size: 1.15rem; } .bars { height: 22px; }
    .legend { display: none; } .viz__alerts { width: 78%; } .viz__score { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .route { stroke-dashoffset: 0; } .ring { stroke-dashoffset: 9; } .toast:first-child { opacity: 1; }
  }
</style>

<script>
  // Respect reduced-motion for SVG (SMIL) animation, and pause when off-screen to save battery.
  const svg = document.querySelector<SVGSVGElement>('.viz__svg');
  if (svg) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const apply = (visible: boolean) => (reduce.matches || !visible ? svg.pauseAnimations() : svg.unpauseAnimations());
    new IntersectionObserver(([e]) => apply(e.isIntersecting)).observe(svg);
    reduce.addEventListener('change', () => apply(true));
  }
</script>

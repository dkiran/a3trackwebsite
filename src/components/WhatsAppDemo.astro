---
// Animated WhatsApp-style chat with the AI agent:
//  1. a text question in English, answered with a live map
//  2. a text question in a regional language (Telugu), answered in the same language
//  3. a voice note (Hindi), answered with a voice note and an ETA map
const { plate = 'AP09CC2318' } = Astro.props;
const bars = (seed: number) => Array.from({ length: 22 }, (_, i) => 25 + Math.round(Math.abs(Math.sin((i + 1) * seed)) * 75));
---
<div class="phone wa" data-demo="21000" role="img" aria-label={`Illustration of a WhatsApp chat with the A3Track AI agent. The user asks in English where vehicle ${plate} is and gets a live map. The user then asks about fuel in Telugu and is answered in Telugu. Finally the user sends a voice message in Hindi and the agent replies with a voice message and a map showing the arrival time.`}>
  <div class="phone__screen">
    <div class="wa__head">
      <span class="wa__av">A3</span>
      <div><strong>A3Track AI Agent</strong><small>online · 24/7</small></div>
    </div>
    <div class="wa__body">
      <div class="wa__scroll">
        <div class="row row--out" data-at="500"><div class="b b--out">Where is my vehicle {plate}?<time>10:42 ✓✓</time></div></div>
        <div class="row" data-at="1300" data-off="2900"><div class="typing"><i></i><i></i><i></i></div></div>
        <div class="row" data-at="3000"><div class="b b--in"><strong>{plate}</strong> is moving at 46 km/h near Gachibowli, Hyderabad.<time>10:42</time></div></div>
        <div class="row" data-at="3900">
          <div class="b b--in b--map">
            <svg viewBox="0 0 240 104" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <rect width="240" height="104" fill="#e8eef5" />
              <g stroke="#fff" stroke-width="9" fill="none" stroke-linecap="round"><path d="M-10 76 H250" /><path d="M70 -10 V120" /><path d="M176 -10 V120" /><path d="M-10 12 L250 62" /></g>
              <g fill="#d5e6d3"><rect x="84" y="4" width="60" height="22" rx="4" /><rect x="190" y="84" width="44" height="16" rx="4" /></g>
              <g fill="#dbe4f0"><rect x="8" y="28" width="46" height="30" rx="4" /></g>
              <path class="wa__route" d="M-6 76 H70 V36 L176 54 V76" fill="none" stroke="#2563eb" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" pathLength="100" />
              <g transform="translate(176 76)"><circle class="wa__ping" r="7" fill="none" stroke="#2563eb" stroke-width="2" /><circle r="7" fill="#2563eb" stroke="#fff" stroke-width="3" /></g>
            </svg>
            <div class="wa__mapmeta"><strong>Live location</strong><small>ORR, Gachibowli · updated just now</small></div>
          </div>
        </div>

        <!-- Regional language (Telugu): "How much fuel is there?" / "Fuel is at 62% (148 litres). No alerts today." -->
        <div class="row row--out" data-at="6400"><div class="b b--out" lang="te">ఇంధనం ఎంత ఉంది?<time>10:43 ✓✓</time></div></div>
        <div class="row" data-at="7200" data-off="8600"><div class="typing"><i></i><i></i><i></i></div></div>
        <div class="row" data-at="8700"><div class="b b--in" lang="te">ఇంధనం 62% (148 లీటర్లు) ఉంది. ఈ రోజు ఎలాంటి హెచ్చరికలు లేవు.<time>10:43</time></div></div>

        <!-- Voice note (Hindi): "When will the vehicle reach the depot?" / "The vehicle will reach the depot in 25 minutes." -->
        <div class="row row--out" data-at="11200">
          <div class="b b--out b--voice">
            <div class="vn"><span class="vn__play"></span><span class="vn__bars">{bars(1.7).map((h) => <i style={`height:${h}%`}></i>)}</span><span class="vn__t">0:04</span></div>
            <p class="vn__tx" lang="hi"><b>Voice</b> “गाड़ी डिपो कब पहुँचेगी?”</p>
            <time>10:44 ✓✓</time>
          </div>
        </div>
        <div class="row" data-at="12100" data-off="13900"><div class="typing typing--rec"><b></b>recording audio…</div></div>
        <div class="row" data-at="14000">
          <div class="b b--in b--voice">
            <div class="vn vn--playing"><span class="vn__play"></span><span class="vn__bars">{bars(2.3).map((h, i) => <i style={`height:${h}%;--i:${i}`}></i>)}</span><span class="vn__t">0:06</span></div>
            <p class="vn__tx" lang="hi"><b>Voice</b> “गाड़ी 25 मिनट में डिपो पहुँच जाएगी।”</p>
            <div class="eta">
              <svg viewBox="0 0 220 44" aria-hidden="true">
                <path d="M14 30 C 60 6, 120 40, 206 14" fill="none" stroke="#cbd5e1" stroke-width="4" stroke-linecap="round" />
                <path class="eta__line" d="M14 30 C 60 6, 120 40, 206 14" fill="none" stroke="#2563eb" stroke-width="4" stroke-linecap="round" pathLength="100" />
                <circle cx="14" cy="30" r="6" fill="#2563eb" stroke="#fff" stroke-width="2.5" />
                <rect x="198" y="6" width="16" height="16" rx="4" fill="#0f172a" />
              </svg>
              <div><strong>ETA 25 min</strong><small>14 km to depot</small></div>
            </div>
            <time>10:44</time>
          </div>
        </div>
      </div>
    </div>
    <div class="wa__input"><span>Message</span><i></i></div>
  </div>
</div>

<style>
  .phone { width: min(100%, 300px); margin-inline: auto; border-radius: 38px; padding: 9px; background: #0f172a; box-shadow: 0 40px 80px -40px rgba(15, 23, 42, 0.7), 0 0 0 1px rgba(15, 23, 42, 0.9); }
  .phone__screen { border-radius: 30px; overflow: hidden; background: #efe9e0; display: flex; flex-direction: column; color: #111b21; font-size: 0.84rem; line-height: 1.38; letter-spacing: 0; }
  .wa__head { display: flex; align-items: center; gap: 10px; padding: 14px 14px 12px; background: #0b6b5d; color: #fff; }
  .wa__av { width: 34px; height: 34px; border-radius: 50%; background: #fff; color: #0b6b5d; display: grid; place-items: center; font: 700 0.72rem/1 var(--font); }
  .wa__head strong { display: block; font-size: 0.9rem; font-weight: 600; }
  .wa__head small { display: block; font-size: 0.7rem; opacity: .85; }
  /* Fixed-height chat: messages stack from the bottom and older ones scroll off the top. */
  .wa__body { height: 400px; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; padding: 0 10px 8px; }
  .wa__scroll { display: flex; flex-direction: column; }
  .row { display: flex; overflow: hidden; max-height: 0; opacity: 0; }
  .row--out { justify-content: flex-end; }
  .row.on { max-height: 320px; opacity: 1; padding-top: 7px; transition: max-height .5s cubic-bezier(.2, .8, .2, 1), opacity .35s .1s, padding-top .3s; }
  .row.on > * { animation: wa-in .45s cubic-bezier(.2, .8, .2, 1) both; }
  .b { max-width: 88%; padding: 7px 10px 5px; border-radius: 10px; box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08); margin-bottom: 1px; }
  .b[lang], .vn__tx { font-family: system-ui, 'Noto Sans', 'Nirmala UI', 'Kohinoor Devanagari', 'Kohinoor Telugu', sans-serif; }
  .b time { display: block; text-align: right; font-size: 0.6rem; color: #667781; margin-top: 2px; }
  .b--out { background: #d9fdd3; border-top-right-radius: 3px; }
  .b--out time { color: #4f9a8a; }
  .b--in { background: #fff; border-top-left-radius: 3px; }
  .b--map { padding: 4px; width: 88%; }
  .b--map svg { display: block; width: 100%; height: auto; border-radius: 7px; }
  .wa__mapmeta { padding: 5px 6px 3px; }
  .wa__mapmeta strong { display: block; font-size: 0.8rem; }
  .wa__mapmeta small { color: #667781; font-size: 0.68rem; }
  .b--voice { width: 84%; }
  .vn { display: flex; align-items: center; gap: 8px; }
  .vn__play { flex: none; width: 26px; height: 26px; border-radius: 50%; background: #0b6b5d; position: relative; }
  .vn__play::before { content: ''; position: absolute; left: 10px; top: 7.5px; border: 5.5px solid transparent; border-left: 8px solid #fff; border-right: 0; }
  .vn__bars { flex: 1; display: flex; align-items: center; gap: 2px; height: 22px; }
  .vn__bars i { flex: 1; border-radius: 2px; background: #8fb3a6; min-width: 2px; }
  .b--in .vn__bars i { background: #b6c2cc; }
  .row.on .vn--playing .vn__bars i { animation: vn-play .2s linear forwards; animation-delay: calc(var(--i) * 0.2s + .6s); }
  .vn__t { font-size: 0.64rem; color: #667781; }
  .vn__tx { margin: 5px 0 0; font-size: 0.74rem; color: #3b4a54; }
  .vn__tx b { font: 600 0.58rem/1 var(--font); letter-spacing: .06em; text-transform: uppercase; color: #0b6b5d; margin-right: 4px; }
  .eta { display: flex; align-items: center; gap: 8px; margin-top: 6px; padding: 6px; border-radius: 8px; background: #eef3f9; }
  .eta svg { flex: 1; min-width: 0; height: auto; }
  .eta strong { display: block; font-size: 0.76rem; white-space: nowrap; }
  .eta small { display: block; font-size: 0.64rem; color: #667781; white-space: nowrap; }
  .typing { display: flex; align-items: center; gap: 4px; background: #fff; border-radius: 10px; padding: 0 12px; height: 28px; font-size: 0.7rem; color: #667781; }
  .typing i { width: 6px; height: 6px; border-radius: 50%; background: #8696a0; animation: wa-dot 1s infinite; }
  .typing i:nth-child(2) { animation-delay: .15s; } .typing i:nth-child(3) { animation-delay: .3s; }
  .typing--rec b { width: 8px; height: 8px; border-radius: 50%; background: #e5484d; margin-right: 3px; animation: wa-dot 1s infinite; }
  .wa__input { display: flex; align-items: center; gap: 8px; padding: 6px 10px 12px; }
  .wa__input span { flex: 1; background: #fff; border-radius: 999px; padding: 8px 14px; color: #8696a0; font-size: 0.8rem; }
  .wa__input i { width: 34px; height: 34px; border-radius: 50%; background: #0b6b5d; }

  .wa__route { stroke-dasharray: 100; stroke-dashoffset: 100; }
  .row.on .wa__route { animation: wa-draw 1.4s .3s ease-out forwards; }
  .eta__line { stroke-dasharray: 100; stroke-dashoffset: 100; }
  .row.on .eta__line { animation: wa-draw 2.4s .5s ease-out forwards; }
  .wa__ping { animation: wa-ping 1.8s ease-out infinite; transform-origin: center; transform-box: fill-box; }
  /* Without JavaScript, show the whole conversation. */
  :global(html:not(.js)) .row:not([data-off]) { max-height: none; opacity: 1; padding-top: 7px; }
  :global(html:not(.js)) .wa__route, :global(html:not(.js)) .eta__line { stroke-dashoffset: 0; }

  @keyframes wa-in { from { opacity: 0; transform: translateY(10px) scale(.97); } to { opacity: 1; transform: none; } }
  @keyframes wa-draw { to { stroke-dashoffset: 0; } }
  @keyframes wa-ping { from { transform: scale(1); opacity: .9; } to { transform: scale(3); opacity: 0; } }
  @keyframes wa-dot { 0%, 60%, 100% { opacity: .3; transform: none; } 30% { opacity: 1; transform: translateY(-2px); } }
  @keyframes vn-play { to { background: #2563eb; } }
  @media (prefers-reduced-motion: reduce) { .wa__route, .eta__line { stroke-dashoffset: 0; } }
</style>

<script>
  import { initStandaloneDemos } from '../scripts/demo';
  initStandaloneDemos();
</script>

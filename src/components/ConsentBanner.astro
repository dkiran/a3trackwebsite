---
// Google Analytics 4, loaded only after the visitor accepts analytics cookies.
// Nothing is requested from Google until then; declining (or having JavaScript off) means no tracking.
// The choice is stored in this browser and can be changed with the "Cookie settings" link in the footer.
import { site } from '../config/site';
const GA_ID = site.gaMeasurementId;
---
{GA_ID && (
  <div class="consent" data-consent hidden role="dialog" aria-live="polite" aria-labelledby="consent-title">
    <p class="consent__title" id="consent-title">Can we use analytics cookies?</p>
    <p class="consent__text">We use Google Analytics to see which pages are useful, so we can improve the site. No advertising, and nothing is shared for marketing. You can change your choice at any time. <a href="/cookies/">Cookie policy</a></p>
    <div class="consent__btns">
      <button type="button" class="btn btn--primary btn--sm" data-consent-accept>Accept</button>
      <button type="button" class="btn btn--ghost btn--sm" data-consent-decline>Decline</button>
    </div>
  </div>
  <script is:inline define:vars={{ GA_ID }}>
    (function () {
      var KEY = 'veyro-analytics-consent';
      var banner = document.querySelector('[data-consent]');
      var loaded = false;
      function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
      function save(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      function load() {
        gtag('consent', 'update', { analytics_storage: 'granted' });
        if (loaded) return;
        loaded = true;
        gtag('js', new Date());
        gtag('config', GA_ID);
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
        document.head.appendChild(s);
      }
      function clearCookies() {
        document.cookie.split(';').forEach(function (c) {
          var name = c.split('=')[0].trim();
          if (name === '_ga' || name.indexOf('_ga_') === 0) {
            var host = location.hostname.replace(/^www\./, '');
            ['', '; domain=' + host, '; domain=.' + host].forEach(function (d) {
              document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + d;
            });
          }
        });
      }
      function show() { banner.hidden = false; }
      function hide() { banner.hidden = true; }
      var choice = read();
      if (choice === 'granted') load(); else if (choice !== 'denied') show();
      banner.querySelector('[data-consent-accept]').addEventListener('click', function () { save('granted'); hide(); load(); });
      banner.querySelector('[data-consent-decline]').addEventListener('click', function () {
        save('denied'); hide();
        if (loaded) gtag('consent', 'update', { analytics_storage: 'denied' });
        clearCookies();
      });
      document.querySelectorAll('[data-consent-open]').forEach(function (b) {
        b.hidden = false;
        b.addEventListener('click', show);
      });
    })();
  </script>
)}

<style>
  .consent { position: fixed; z-index: 150; left: max(16px, env(safe-area-inset-left, 0px)); right: max(16px, env(safe-area-inset-right, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); max-width: 440px; padding: 18px 18px 16px; border-radius: 16px; background: #fff; color: var(--text); border: 1px solid var(--line-strong); box-shadow: 0 24px 60px -24px rgba(15, 23, 42, 0.45); }
  .consent[hidden] { display: none; }
  .consent__title { margin: 0 0 6px; font: 600 1rem/1.3 var(--display); }
  .consent__text { margin: 0 0 14px; font-size: 0.88rem; line-height: 1.45; color: var(--muted); }
  .consent__btns { display: flex; gap: 10px; }
  .consent__btns .btn { flex: 1; }
</style>

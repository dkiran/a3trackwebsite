---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Page Not Found" description="The page you were looking for could not be found." noindex>
  <PageHero eyebrow="Error 404" title="This route does not exist" lead="The page may have moved, or the link may be incorrect. Let us get you back on track." cta={false}>
    <div class="btn-row"><a class="btn btn--primary" href="/">Back to home</a><a class="btn btn--ghost" href="/solutions/">Solutions</a><a class="btn btn--ghost" href="/industries/">Industries</a><a class="btn btn--ghost" href="/contact/">Contact</a></div>
  </PageHero>
</Base>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { faqGroups } from '../data/faqs';
import { faqSchema } from '../lib';
const crumbs = [{ name: 'FAQ', href: '/faq/' }];
const seen = new Set<string>();
const all = faqGroups.flatMap((g) => g.items).filter((f) => !seen.has(f.q) && seen.add(f.q));
---
<Base title="GPS Tracking & Telematics FAQ" description="Answers to common questions about Veyro, GPS fleet tracking, AI in fleet management, hardware, deployment, pricing, security and privacy." crumbs={crumbs} schema={[faqSchema(all)]}>
  <PageHero crumbs={crumbs} eyebrow="FAQ" title="Questions, answered plainly" lead="Everything people ask us about GPS telematics and Veyro. Cannot find your answer? Our team is one message away." cta={false} />
  {faqGroups.map((g, i) => (
    <section class={`section section--tight ${i % 2 ? '' : 'section--alt'}`}>
      <div class="container"><div class="faq" style="margin-bottom:8px"><h2 class="reveal">{g.title}</h2></div><Faq items={g.items} /></div>
    </section>
  ))}
  <Cta title="Still have a question?" text="Talk to a fleet specialist. No pressure, just answers." />
</Base>

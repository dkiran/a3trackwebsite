---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { solutions } from '../data/solutions';
import { industries } from '../data/industries';
import { homeFaqs } from '../data/faqs';
import { faqSchema } from '../lib';
import { site } from '../config/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const software = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'A3Track Fleet Intelligence Platform',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Fleet management and GPS telematics software',
  operatingSystem: 'Web, iOS, Android',
  description: site.description,
  url: site.url,
  publisher: { '@id': `${site.url}/#organization` },
  featureList: solutions.map((s) => s.name),
};
const why = [
  { icon: 'brain', title: 'AI at the core', text: 'Not dashboards to dig through. A3Track surfaces the few things that need attention today and recommends the next step.' },
  { icon: 'globe', title: 'One platform, every asset', text: 'Vehicles, trailers, machines, cameras and sensors in one place, with one login and one data model.' },
  { icon: 'plug', title: 'Open by design', text: 'A documented API and webhooks connect A3Track to your ERP, TMS and BI tools. Your data stays yours.' },
  { icon: 'lock', title: 'Enterprise-grade security', text: 'Encryption in transit and at rest, single sign-on, granular roles and complete audit trails.' },
  { icon: 'chip', title: 'Hardware that lasts', text: 'Rugged, certified devices with over-the-air updates, so the fleet you install today keeps improving.' },
  { icon: 'users', title: 'People who pick up', text: 'Guided onboarding, training and responsive support from specialists who understand fleet operations.' },
];
const nums = [
  { n: 9, s: '', label: 'connected solutions on one platform' },
  { n: 14, s: '', label: 'industries with tailored workflows' },
  { n: 4, s: '+', label: 'satellite constellations supported' },
  { n: 24, s: '/7', label: 'live visibility on web and mobile' },
];
---
<Base fullTitle title="A3Track — AI-Powered GPS Telematics & Fleet Management Platform" description="A3Track is the AI-powered GPS telematics platform for fleets. Real-time vehicle tracking, AI dash cams, fuel monitoring, maintenance and compliance. Move Smarter." schema={[software, faqSchema(homeFaqs)]}>
  <Hero />

  <section class="strip" aria-label="Industries served">
    <div class="marquee">
      <ul>
        {[...industries, ...industries].map((i, idx) => (
          <li aria-hidden={idx >= industries.length ? 'true' : undefined}><Icon name={i.icon} size={18} />{i.name}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="answer reveal">
        <h2>What is A3Track?</h2>
        <p>
          A3Track is an AI-powered GPS telematics and fleet intelligence platform. It connects GPS trackers, AI dash cams
          and sensors in your vehicles and assets to cloud software that shows where everything is in real time, detects
          risk and waste automatically, and helps your team dispatch faster, drive safer, spend less on fuel and
          maintenance and stay compliant.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="solutions">
    <div class="container">
      <div class="head center reveal">
        <span class="eyebrow">Solutions</span>
        <h2>Everything your fleet needs, working together</h2>
        <p class="lead">Start with tracking. Add safety, fuel, maintenance and more as you grow. Every module shares the same data and the same AI.</p>
      </div>
      <div class="grid g3">
        {solutions.map((s, i) => (
          <a class="card reveal" style={`--d:${(i % 3) * 80}ms`} href={`/solutions/${s.slug}/`}>
            <span class="ico"><Icon name={s.icon} /></span>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <span class="more">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">AI fleet intelligence</span>
        <h2>From millions of data points to the three things that matter today</h2>
        <p class="lead">Every vehicle produces thousands of signals a day. A3Track AI reads them all, so your team does not have to.</p>
        <ul class="checks" style="margin:24px 0 28px">
          <li><strong>Sees risk as it happens.</strong> On-device vision AI detects distraction, drowsiness and tailgating and warns the driver instantly.</li>
          <li><strong>Predicts failures.</strong> Models learn each vehicle's normal behaviour and flag battery, cooling and engine anomalies early.</li>
          <li><strong>Finds hidden waste.</strong> Fuel drains, excess idling and route deviations are surfaced automatically.</li>
          <li><strong>Answers in plain language.</strong> Ask a question about your fleet and get an answer, not a spreadsheet.</li>
        </ul>
        <a class="arrow-link" href="/platform/ai-fleet-intelligence/">Explore A3Track AI</a>
      </div>
      <div class="aipanel reveal" style="--d:120ms" aria-hidden="true">
        <div class="aipanel__q"><span>You</span>Which vehicles need attention this week?</div>
        <div class="aipanel__a">
          <span class="aipanel__tag">A3Track AI</span>
          <p>Three vehicles need attention:</p>
          <ul>
            <li><i style="--c:var(--red)"></i><div><strong>Bus 77</strong><small>Battery voltage trending down. Service within 5 days.</small></div><b>High</b></li>
            <li><i style="--c:var(--amber)"></i><div><strong>Truck 214</strong><small>Harsh braking up 3× on the night shift. Coaching suggested.</small></div><b>Med</b></li>
            <li><i style="--c:var(--teal)"></i><div><strong>Van 12</strong><small>Idling 41 min/day above fleet average.</small></div><b>Low</b></li>
          </ul>
          <div class="aipanel__typing"><span></span><span></span><span></span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--light" id="industries">
    <div class="container">
      <div class="head center reveal">
        <span class="eyebrow">Industries</span>
        <h2>Built for the way your industry moves</h2>
        <p class="lead">Every sector runs its fleet differently. A3Track ships with workflows, reports and alerts tuned to yours.</p>
      </div>
      <div class="grid g4">
        {industries.map((s, i) => (
          <a class="card reveal" style={`--d:${(i % 4) * 60}ms`} href={`/industries/${s.slug}/`}>
            <span class="ico"><Icon name={s.icon} /></span>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="nums reveal">
        {nums.map((x) => (<div><strong><span data-count={x.n}>{x.n}</span>{x.s}</strong><span>{x.label}</span></div>))}
      </div>
      <div class="head center reveal" style="margin-top:clamp(56px,8vw,96px)">
        <span class="eyebrow">Why A3Track</span>
        <h2>A platform you will not outgrow</h2>
        <p class="lead">Designed for the next decade of fleet operations: electric, connected, automated and accountable.</p>
      </div>
      <div class="grid g3">
        {why.map((w, i) => (
          <div class="card reveal" style={`--d:${(i % 3) * 80}ms`}>
            <span class="ico"><Icon name={w.icon} /></span><h3>{w.title}</h3><p>{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="head center reveal">
        <span class="eyebrow">How it works</span>
        <h2>Live in days, not months</h2>
      </div>
      <div class="grid g3">
        {[
          ['Connect', 'Install A3Track devices in your vehicles and assets, or connect compatible hardware you already own.'],
          ['See', 'Location, video, fuel, engine and sensor data stream to one secure cloud platform on web and mobile.'],
          ['Act', 'AI-prioritised alerts, reports and automations help every team make better decisions, every day.'],
        ].map(([t, d], i) => (
          <div class="card reveal" style={`--d:${i * 100}ms`}><span class="num">0{i + 1}</span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="head reveal" style="display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap;max-width:none">
        <div><span class="eyebrow">Resources</span><h2 style="margin:0">Guides for fleet leaders</h2></div>
        <a class="arrow-link" href="/blog/">All articles</a>
      </div>
      <div class="grid g3">
        {posts.map((p, i) => (
          <a class="card reveal" style={`--d:${i * 80}ms`} href={`/blog/${p.id}/`}>
            <span class="chip" style="margin-bottom:16px;font-size:.78rem;padding:5px 11px">{p.data.category}</span>
            <h3>{p.data.title}</h3><p>{p.data.description}</p><span class="more">Read article →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="head center reveal"><span class="eyebrow">FAQ</span><h2>Frequently asked questions</h2></div>
      <Faq items={homeFaqs} />
      <p class="center" style="margin-top:28px"><a class="arrow-link" href="/faq/">See all questions</a></p>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .strip { border-block: 1px solid var(--line); background: var(--bg-2); padding: 18px 0; overflow: hidden; }
  .marquee { mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .marquee ul { display: flex; gap: 44px; width: max-content; animation: slide 60s linear infinite; }
  .marquee:hover ul { animation-play-state: paused; }
  .marquee li { display: inline-flex; align-items: center; gap: 10px; color: var(--muted); font-weight: 500; font-size: 0.95rem; white-space: nowrap; }
  .marquee li :global(svg) { color: var(--teal); }
  @keyframes slide { to { transform: translateX(calc(-50% - 22px)); } }

  .nums { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; }
  .nums > div { background: var(--bg); padding: 32px 24px; text-align: center; }
  .nums strong { display: block; font: 700 clamp(2.4rem, 5vw, 3.4rem)/1 var(--display); background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; margin-bottom: 10px; }
  .nums div > span { color: var(--muted); font-size: 0.93rem; }

  .aipanel { background: linear-gradient(180deg, #101d3d, #0a1428); border: 1px solid var(--line-strong); border-radius: var(--radius-lg); padding: clamp(18px, 3vw, 28px); box-shadow: 0 40px 100px -40px rgba(59, 130, 255, 0.6); }
  .aipanel__q { margin-left: auto; width: fit-content; max-width: 90%; background: #1c3a85; padding: 12px 16px; border-radius: 16px 16px 4px 16px; font-size: 0.95rem; margin-bottom: 16px; }
  .aipanel__q span { display: block; font-size: 0.68rem; opacity: .7; text-transform: uppercase; letter-spacing: .1em; }
  .aipanel__a { background: rgba(255, 255, 255, 0.04); border: 1px solid var(--line); border-radius: 4px 16px 16px 16px; padding: 16px; }
  .aipanel__tag { font: 700 0.68rem/1 var(--font); letter-spacing: .1em; text-transform: uppercase; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .aipanel__a p { margin: 8px 0 12px; font-size: 0.95rem; }
  .aipanel__a li { display: flex; align-items: center; gap: 12px; padding: 12px; border-radius: 12px; background: rgba(5, 10, 22, 0.6); border: 1px solid var(--line); margin-bottom: 8px; }
  .aipanel__a li i { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--c); box-shadow: 0 0 12px var(--c); }
  .aipanel__a li div { flex: 1; min-width: 0; }
  .aipanel__a li strong { display: block; font-size: 0.9rem; }
  .aipanel__a li small { color: var(--muted); font-size: 0.8rem; display: block; line-height: 1.4; }
  .aipanel__a li b { font-size: 0.68rem; padding: 4px 8px; border-radius: 6px; border: 1px solid var(--line-strong); color: var(--muted); }
  .aipanel__typing { display: flex; gap: 5px; padding: 6px 2px 0; }
  .aipanel__typing span { width: 6px; height: 6px; border-radius: 50%; background: var(--teal); animation: blink 1.2s infinite; }
  .aipanel__typing span:nth-child(2) { animation-delay: .2s; } .aipanel__typing span:nth-child(3) { animation-delay: .4s; }
  @keyframes blink { 0%, 80%, 100% { opacity: .2; } 40% { opacity: 1; } }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>('[data-count]');
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      const el = e.target as HTMLElement;
      const end = Number(el.dataset.count);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const t0 = performance.now();
      const tick = (t: number) => {
        const p = Math.min(1, (t - t0) / 1200);
        el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }, { threshold: 0.4 });
  els.forEach((el) => io.observe(el));
</script>

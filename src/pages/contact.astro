---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { industries } from '../data/industries';
const crumbs = [{ name: 'Contact', href: '/contact/' }];
const schema = { '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact A3Track', url: `${site.url}/contact/`, mainEntity: { '@id': `${site.url}/#organization` } };
---
<Base title="Contact A3Track — Request a Demo" description="Talk to A3Track. Request a personalised demo of our AI-powered GPS telematics platform, get a quote for your fleet or reach our support team." crumbs={crumbs} schema={[schema]}>
  <PageHero crumbs={crumbs} eyebrow="Contact" title="See A3Track on your fleet" lead="Tell us a little about your operation. A specialist will get back to you within one business day with a personalised demo and quote." cta={false} />
  <section class="section section--alt" id="demo" style="padding-top:40px">
    <div class="container split" style="align-items:start">
      <div class="card reveal" style="height:auto">
        <h2 style="font-size:1.5rem">Request a demo</h2>
        <form class="form" id="demo-form" action={site.formEndpoint} method="post" novalidate>
          <div class="row">
            <div class="field"><label for="name">Full name *</label><input id="name" name="name" autocomplete="name" required maxlength="100" /></div>
            <div class="field"><label for="company">Company *</label><input id="company" name="company" autocomplete="organization" required maxlength="120" /></div>
          </div>
          <div class="row">
            <div class="field"><label for="email">Work email *</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="160" /></div>
            <div class="field"><label for="phone">Phone *</label><input id="phone" name="phone" type="tel" autocomplete="tel" required maxlength="30" /></div>
          </div>
          <div class="row">
            <div class="field"><label for="fleet">Fleet size</label>
              <select id="fleet" name="fleetSize"><option>1–10</option><option>11–50</option><option>51–200</option><option>201–1,000</option><option>1,000+</option></select></div>
            <div class="field"><label for="industry">Industry</label>
              <select id="industry" name="industry">{industries.map((i) => <option>{i.name}</option>)}<option>Other</option></select></div>
          </div>
          <div class="field"><label for="message">What would you like to solve?</label><textarea id="message" name="message" maxlength="2000"></textarea></div>
          <div class="hp" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
          <button class="btn btn--primary" type="submit">Request my demo</button>
          <p class="form__status" role="status" aria-live="polite"></p>
          <p class="form__note">By submitting, you agree to our <a href="/privacy/">privacy policy</a>. We will only use your details to respond to this request.</p>
        </form>
      </div>
      <div class="reveal" style="--d:120ms">
        <h2 style="font-size:1.5rem">Other ways to reach us</h2>
        <ul class="contacts">
          <li><span class="ico"><Icon name="mail" /></span><div><strong>Sales</strong><a href={`mailto:${site.salesEmail}`}>{site.salesEmail}</a></div></li>
          <li><span class="ico"><Icon name="tool" /></span><div><strong>Support</strong><a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a></div></li>
          <li><span class="ico"><Icon name="phone" /></span><div><strong>Phone</strong><a href={`tel:${site.phoneHref}`}>{site.phone}</a></div></li>
          <li><span class="ico"><Icon name="pin" /></span><div><strong>Head office</strong><span>{site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}, {site.address.countryName}</span></div></li>
        </ul>
        <h3 style="margin-top:32px">What happens next</h3>
        <ul class="checks"><li>We confirm your request by email.</li><li>A specialist learns about your fleet and goals.</li><li>You see a live demo configured for your industry.</li><li>You receive a clear, itemised quote.</li></ul>
      </div>
    </div>
  </section>
</Base>
<style>
  .contacts li { display: flex; gap: 14px; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .contacts .ico { flex: none; width: 42px; height: 42px; border-radius: 11px; display: grid; place-items: center; color: var(--teal); background: rgba(11, 99, 160, 0.14); }
  .contacts .ico :global(svg) { width: 20px; height: 20px; }
  .contacts strong { display: block; font-size: 0.85rem; color: var(--muted); font-weight: 500; }
  .contacts span, .contacts a { color: var(--text); }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('#demo-form');
  const status = form?.querySelector<HTMLElement>('.form__status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    btn.disabled = true; status!.className = 'form__status'; status!.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
      if (!res.ok) throw new Error(String(res.status));
      window.location.href = '/thank-you/';
    } catch {
      status!.className = 'form__status err';
      status!.textContent = 'Sorry, something went wrong. Please email us directly and we will respond quickly.';
      btn.disabled = false;
    }
  });
</script>
